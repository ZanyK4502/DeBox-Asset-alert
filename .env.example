APP_NAME=DeBox Asset Alert
APP_ENV=development
APP_HOST=0.0.0.0
PUBLIC_APP_URL=
DATABASE_URL=

DEBOX_BOT_API_KEY=
# Required by signed paid sendMessage v2; keep only on the backend.
DEBOX_BOT_API_SECRET=
DEBOX_BOT_USER_ID=
DEBOX_BOT_RECEIVE_MODE=polling
DEBOX_WEBHOOK_KEY=
DEBOX_OPENAPI_BASE=https://open.debox.pro
DEBOX_NOTIFICATION_CHAT_ID=
DEBOX_NOTIFICATION_CHAT_TYPE=private
# Paid v2: shared rolling admissions per bot, across keys and instances.
# 100 is admission capacity, not guaranteed completed delivery per minute.
# 5/10 remain supported conservative local caps; no free-route fallback.
DEBOX_SEND_PER_MINUTE=100

CHAIN_ID=56
CHAIN_NAME=BSC
CHAIN_KEY=bsc
NODIT_API_KEY=
NODIT_BASE_URL=https://web3.nodit.io/v1
NODIT_CU_PER_SECOND=400
# Robot usage metadata budget; provider quota/rate limits still apply separately.
NODIT_MONTHLY_CU_LIMIT=300000000

# Sales use independent tier limits. Monthly CU usage is recorded separately.
RESOURCE_STANDARD_SALES_SEAT_LIMIT=3
RESOURCE_PROFESSIONAL_SALES_SEAT_LIMIT=2
# The optional monthly admission model also requires verified costs below.
RESOURCE_ENFORCE_MONTHLY_CU=false
RESOURCE_CAPACITY_VERIFIED=false
RESOURCE_ACCOUNT_MONTHLY_CU=450000000
# Agreed full-month split: swapbot 150M; robot 300M, including 60M safety.
# The remaining 240M must still cover background and user commitments.
# Background remains UNKNOWN, not an approved zero. No prorated-month model.
RESOURCE_OTHER_MONTHLY_CU=150000000
RESOURCE_BACKGROUND_MONTHLY_CU=
RESOURCE_SAFETY_MONTHLY_CU=60000000
# Known 31-day unit floors, NOT upper bounds for retries or cold caches.
RESOURCE_ORDINARY_RULE_MONTHLY_CU=1437408
RESOURCE_INTERACTION_RULE_MONTHLY_CU=6696000
# Unknown cost per chain/token collection unit. While unverified, empty uses the entire account budget
# as a conservative placeholder, NOT a monthly cost forecast. Verified=true
# requires an explicit positive measured value, reserves and cost scope below.
# Reserve sum may equal the account budget: startup is allowed with zero slots.
RESOURCE_MARKET_PROJECT_MONTHLY_CU=
# Declare the measured chain/token unit cost's coverage before verification.
# It must cover each allowed chain and up to the project-wide pool limit.
# A BSC-only or 2-pool cost cannot cover the six-chain 5-pool target.
# A plan reserves projects * min(allowed chains, pools per project) such units;
# it does not multiply a unit's complete pool envelope again by the pool count.
RESOURCE_MARKET_PROJECT_COST_MAX_POOLS=
RESOURCE_MARKET_PROJECT_COST_CHAIN_KEYS=
# Optional per-chain model. Supply a JSON object {"bsc":{"deployment":N,"pool":N},...}
# with measured positive CU for each allowed chain. The amount for an active
# token deployment includes work even with zero selected pools. Each selected
# pool adds its chain's pool CU. The same pool-coverage limit above still applies.
# When provided, this replaces the flat market-project price and chain list.
RESOURCE_MARKET_CHAIN_MONTHLY_CU=

# Market collection remains inert until explicitly enabled during cutover.
MARKET_COLLECTOR_ENABLED=false
# Comma-separated. Empty defaults to all six supported EVM chains.
MARKET_CHAIN_KEYS=bsc,ethereum,base,polygon,arbitrum,optimism
# Product scope for persistent market monitoring, independent of wallet chains.
# Empty defaults to the six supported EVM chains; an explicit subset stays valid.
MARKET_MONITORING_CHAIN_KEYS=bsc,ethereum,base,polygon,arbitrum,optimism
MARKET_RULE_ENGINE_ENABLED=false
MARKET_RULE_INTERVAL=5s
MARKET_HOLDER_REFRESH_INTERVAL=15m
DEXSCREENER_BASE_URL=https://api.dexscreener.com
NODIT_WEBHOOK_SIGNING_KEY=
# Legacy unscoped categories are BNB-only. Other chains use keys such as
# "base:transfer" and "ethereum:transfer" inside this JSON object.
# For recovery after losing a creation response, set the matching chain:transfer entry to subscriptionId:signingKey from Nodit Console.
NODIT_WEBHOOK_SIGNING_KEYS_JSON={}
# Keep this stable across replicas/backups. Base64 of 32 random bytes protects newly provisioned per-chain signing keys.
NODIT_WEBHOOK_WRAPPING_KEY=
MARKET_WEBHOOK_AUTO_REPAIR=false
MARKET_CONFIRMATION_DEPTH=15
# Optional per-chain overrides, for example {"polygon":128,"ethereum":12}.
MARKET_CONFIRMATION_DEPTHS_JSON={}
# Bounded range: 1..1000; confirmation depth and scan cadence stay unchanged.
MARKET_SCAN_BATCH_SIZE=500
MARKET_HYDRATION_CONCURRENCY=2
# Market session locks: 1..16; four more slots are reserved for legacy tasks.
# This separate pool never borrows the query pool's working connections.
MARKET_TASK_LOCK_CONNECTIONS=8
# Up to two HTTPS read endpoints per canonical chain. No getLogs/Data fallback.
# Example: {"bsc":["https://example.org/rpc"]}; legacy CHAIN_RPC_URL is BNB-only.
# Explicit "bsc":[] disables that legacy fallback route.
MARKET_RPC_FALLBACK_URLS_JSON={}
MARKET_INITIAL_LOOKBACK=200
MARKET_REORG_LOOKBACK=128
MARKET_INBOX_INTERVAL=2s
MARKET_SCAN_INTERVAL=1m
MARKET_SNAPSHOT_INTERVAL=20s
MARKET_DISCOVERY_INTERVAL=5m
MARKET_HEALTH_INTERVAL=1m
MARKET_CLEANUP_INTERVAL=6h

SUBSCRIPTION_TOKEN_ADDRESS=0x55d398326f99059fF775485246999027B3197955
SUBSCRIPTION_TOKEN_SYMBOL=USDT
SUBSCRIPTION_TOKEN_DECIMALS=18
SUBSCRIPTION_PRICE=5
SUBSCRIPTION_DAYS=30
# Shared rule slots across wallet/market/combination rules, for all identities.
# Interaction is included in the professional shared total, not extra slots.
# Changing these capacities does not change prices, terms or feature access.
# Free remains exactly 1 until its single selected-rule fallback is extended.
QUOTA_FREE_RULE_LIMIT=1
QUOTA_STANDARD_RULE_LIMIT=3
QUOTA_PROFESSIONAL_RULE_LIMIT=10
QUOTA_PROFESSIONAL_INTERACTION_RULE_LIMIT=1
QUOTA_PROFESSIONAL_MARKET_PROJECT_LIMIT=5
# Standard retains primary-pool mode and must remain 1 in this release.
QUOTA_STANDARD_MARKET_POOL_LIMIT=1
QUOTA_PROFESSIONAL_MARKET_POOL_LIMIT=5
PAYMENT_RECIPIENT_ADDRESS=
PAYMENT_MODE=preview
COMPLIMENTARY_WALLET_ADDRESSES=
